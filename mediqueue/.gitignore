# ==============================================================================
# MediQueue Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Python Caches & Virtual Envirnoments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Production Build Outputs
build/
frontend/build/
dist/
out/
.next/

# Deployment & Hosting Metadata
.vercel
.serverless/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
