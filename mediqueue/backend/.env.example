# ==============================================================================
# MediQueue Backend Environment Configuration (.env.example)
# Copy this file to .env and configure with your credentials before running.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL / TiDB / Railway / Clever Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=mediqueue
# Set to 'true' if connecting to a cloud database requiring SSL (e.g. TiDB, Aiven, Render)
DB_SSL=false

# Machine Learning Wait-Time Prediction Service URL
# Local development: http://localhost:5001
# Production (e.g., Render): https://your-ml-service.onrender.com
ML_SERVICE_URL=http://localhost:5001

# Frontend Client URL (For CORS whitelist)
# Local development: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# JSON Web Token Authentication
JWT_SECRET=your_super_secret_random_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# Email Notification Service (Gmail SMTP for OTPs and Confirmation Emails)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
