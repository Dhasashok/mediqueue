# ==============================================================================
# MediQueue Machine Learning Service Environment Configuration (.env.example)
# Copy this file to .env and configure with your credentials before running.
# ==============================================================================

# Server Port (default: 5001)
PORT=5001

# Database Configuration (Required for continuous retraining pipeline: retrain.py)
# Compatible with MySQL 8.0+, MariaDB, TiDB Cloud, Aiven, or Clever Cloud
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=mediqueue

# Shared Bearer Token for Internal ML Retraining Endpoint (POST /retrain)
# Must match the ML_INTERNAL_SECRET defined in backend/.env to allow secure triggering
ML_INTERNAL_SECRET=change_this_to_a_secure_random_ml_token_min_32_chars
